  "title": "紐約時報 — 21世紀100佳電影",
  "description": "基於《紐約時報》「21世紀100佳電影」評選製作。第一個 section 顯示 Top 10，第二個 section 依榜單標示的電影年份分年代展示，由新到舊。",
  "tags": [
    "press",
    "movie",
    "nytimes"
  ],
  "icon": "film",
  "sections": [
    {
      "title": "Top 10",
      "layout": "carousel",
      "limit": 10,
      "filters": [
        {
          "id": "top10-rank-lt-11",
          "targetType": "movie",
          "field": "rank",
          "fieldType": "number",
          "operator": "lessThan",
          "value": "11",
          "isNegated": false
        }
      ],
      "sortBy": [
        [
          "rank",
          "asc"
        ]
      ],
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/press/zh-Hant/nyt-best-movies-21st-century.list.json"
        }
      ],
      "bindings": [
        "Title with Year",
        "ranking"
      ]
    },
    {
      "title": "各年代電影",
      "layout": "grid",
      "sortBy": [
        [
          "rank",
          "asc"
        ]
      ],
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/press/zh-Hant/nyt-best-movies-21st-century.list.json"
        }
      ],
      "bindings": [
        "Title with Year",
        "ranking"
      ],
      "grouping": {
        "field": "releaseYear",
        "buckets": "2020,2010,,2000",
        "label": "{start} 年代"
      }
    }
  ]
