          "id": "top10-rank-lt-11",
          "targetType": "show",
          "field": "rank",
          "fieldType": "number",
          "operator": "lessThan",
          "value": "11",
          "isNegated": false
        }
      ],
      "sortBy": [
        [
          "rank",
          "asc"
        ]
      ],
      "service": "mydea",
