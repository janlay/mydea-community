    {
      "title": "Primetime Emmy Awards 2017–2026",
      "layout": "grid",
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/awards/en/emmys.list.json"
        }
      ],
      "sortBy": [
        [
          "awardYear",
          "desc"
        ]
      ],
      "bindings": [
        "winner",
        "Title with Year"
      ],
      "filters": [
        {
          "id": "years-from",
          "targetType": "show",
          "field": "awardYear",
          "fieldType": "number",
          "operator": "greaterThan",
          "value": "2016",
          "isNegated": false
        },
        {
          "id": "years-to",
          "targetType": "show",
          "field": "awardYear",
          "fieldType": "number",
          "operator": "lessThan",
          "value": "2027",
          "isNegated": false
        }
      ],
      "filterMatchMode": "all",
      "grouping": {
        "field": "awardYear",
        "buckets": "2026,2025,,2017",
        "label": "{start}"
      }
    }
