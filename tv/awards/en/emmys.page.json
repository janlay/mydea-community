    {
      "title": "Primetime Emmy Awards — Outstanding Drama Series",
      "description": "Winners of the Primetime Emmy Award for Outstanding Drama Series.",
      "layout": "carousel",
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/awards/en/emmys.list.json"
        }
      ],
      "sortBy": [
        [
          "awardYear",
          "desc"
        ]
      ],
      "limit": 10,
      "bindings": [
        "winner",
        "Title with Year"
      ],
      "filters": [
        {
          "id": "emmys-drama-series-award",
          "targetType": "show",
          "field": "award",
          "fieldType": "text",
          "operator": "equals",
          "value": "Outstanding Drama Series",
          "isNegated": false
        }
      ],
      "filterMatchMode": "all"
    },
