  "tags": [
    "award",
    "decade"
  ],
  "icon": "ticket",
  "sections": [
    {
      "title": "坎城 — 2026",
      "description": "第79屆坎城影展官方影片相關獎項，涵蓋主競賽單元, 短片, 一種關注單元, 金攝影機獎, 電影基石單元 以及 CST 技術獎。",
      "sortBy": [
        [
          "awardYear",
          "desc"
        ]
      ],
      "layout": "carousel",
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/awards/zh-Hant/cannes.list.json"
        }
      ],
      "bindings": [
        "winner",
        "award"
      ],
      "filters": [
        {
          "id": "cannes-2026-year",
          "targetType": "movie",
          "field": "awardYear",
          "fieldType": "number",
          "operator": "equals",
          "value": "2026",
          "isNegated": false
        }
      ],
      "filterMatchMode": "all"
    },
    {
      "title": "坎城 2017–2025",
      "sortBy": [
        [
          "awardYear",
          "desc"
        ]
      ],
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/awards/zh-Hant/cannes.list.json"
        }
      ],
      "layout": "grid",
      "bindings": [
        "winner",
        "award"
      ],
      "filters": [
        {
          "id": "older-years-from",
          "targetType": "movie",
          "field": "awardYear",
          "fieldType": "number",
          "operator": "greaterThan",
          "value": "2016",
          "isNegated": false
        },
        {
          "id": "older-years-to",
          "targetType": "movie",
          "field": "awardYear",
          "fieldType": "number",
          "operator": "lessThan",
          "value": "2026",
          "isNegated": false
        }
      ],
      "filterMatchMode": "all",
      "grouping": {
        "field": "awardYear",
        "buckets": "2025,2024,,2017",
        "label": "{start}"
      }
    }
  ]
}
