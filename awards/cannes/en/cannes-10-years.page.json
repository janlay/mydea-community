{
  "schemaVersion": 1,
  "kind": "page",
  "author": "Mydea",
  "title": "Ten Years in Cannes",
  "description": "Ten years of the Festival de Cannes. 2020 is absent: the festival was cancelled.",
  "tags": [
    "award",
    "decade"
  ],
  "icon": "ticket",
  "sections": [
    {
      "title": "Cannes — 2026",
      "description": "Official film-linked awards from the 79th Festival de Cannes, covering Competition, Short Films, Un Certain Regard, Caméra d'Or, La Cinef and CST technical prizes.",
      "sortBy": [
        [
          "awardYear",
          "desc"
        ]
      ],
      "layout": "carousel",
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/awards/en/cannes.list.json"
        }
      ],
      "bindings": [
        "winner",
        "award"
      ],
      "filters": [
        {
          "id": "cannes-2026-year",
          "targetType": "movie",
          "field": "awardYear",
          "fieldType": "number",
          "operator": "equals",
          "value": "2026",
          "isNegated": false
        }
      ],
      "filterMatchMode": "all"
    },
    {
      "title": "Cannes 2017–2025",
      "sortBy": [
        [
          "awardYear",
          "desc"
        ]
      ],
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/awards/en/cannes.list.json"
        }
      ],
      "layout": "grid",
      "bindings": [
        "winner",
        "award"
      ],
      "filters": [
        {
          "id": "older-years-from",
          "targetType": "movie",
          "field": "awardYear",
          "fieldType": "number",
          "operator": "greaterThan",
          "value": "2016",
          "isNegated": false
        },
        {
          "id": "older-years-to",
          "targetType": "movie",
          "field": "awardYear",
          "fieldType": "number",
          "operator": "lessThan",
          "value": "2026",
          "isNegated": false
        }
      ],
      "filterMatchMode": "all",
      "grouping": {
        "field": "awardYear",
        "buckets": "2025,2024,,2017",
        "label": "{start}"
      }
    }
  ]
}
