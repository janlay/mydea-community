      "title": "Cannes — Palme d’Or",
      "description": "Cannes Film Festival Palme d'Or and historical top-prize winning films.",
      "layout": "carousel",
      "limit": 10,
      "sortBy": [
        [
          "awardYear",
          "desc"
        ]
      ],
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/awards/en/cannes.list.json"
        }
      ],
      "bindings": [
        "winner",
        "title with Year"
      ],
      "filters": [
        {
          "id": "cannes-palme-dor-award",
          "targetType": "movie",
          "field": "award",
          "fieldType": "text",
          "operator": "equals",
          "value": "Palme d'Or",
          "isNegated": false
        }
      ],
      "filterMatchMode": "all"
