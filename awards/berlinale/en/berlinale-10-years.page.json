{
  "schemaVersion": 1,
  "kind": "page",
  "author": "Mydea",
  "title": "Ten Years in Berlin",
  "description": "Competition winners of the last ten Berlinale editions, 2026 back to 2017.",
  "tags": [
    "award",
    "decade"
  ],
  "icon": "ticket",
  "collections": [
    {
      "title": "Berlinale — 2026",
      "description": "Major Competition International Jury award winners at the 2026 Berlin International Film Festival.",
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/awards/en/berlinale.list.json"
        }
      ],
      "sortBy": [
        [
          "awardYear",
          "desc"
        ],
        [
          "awardOrder",
          "asc"
        ]
      ],
      "layout": "carousel",
      "bindings": [
        "winner",
        "award"
      ],
      "filters": [
        {
          "id": "berlinale-2026-year",
          "targetType": "movie",
          "field": "awardYear",
          "fieldType": "number",
          "operator": "equals",
          "value": "2026",
          "isNegated": false
        }
      ],
      "filterMatchMode": "all"
    },
    {
      "title": "Berlinale 2017–2025",
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/awards/en/berlinale.list.json"
        }
      ],
      "sortBy": [
        [
          "awardYear",
          "desc"
        ],
        [
          "awardOrder",
          "asc"
        ]
      ],
      "layout": "grid",
      "bindings": [
        "winner",
        "award"
      ],
      "filters": [
        {
          "id": "older-years-from",
          "targetType": "movie",
          "field": "awardYear",
          "fieldType": "number",
          "operator": "greaterThan",
          "value": "2016",
          "isNegated": false
        },
        {
          "id": "older-years-to",
          "targetType": "movie",
          "field": "awardYear",
          "fieldType": "number",
          "operator": "lessThan",
          "value": "2026",
          "isNegated": false
        }
      ],
      "filterMatchMode": "all",
      "grouping": {
        "field": "awardYear",
        "buckets": "2025,2024,,2017",
        "label": "{start}"
      }
    }
  ]
}
