{
  "schemaVersion": 1,
  "kind": "page",
  "author": "Mydea",
  "title": "Berlinale Prizes",
  "description": "Winners of every Berlinale competition award. No awards were given in 1970.",
  "tags": [
    "award",
    "prize"
  ],
  "icon": "ticket",
  "collections": [
    {
      "title": "Berlinale — Golden Bear for Best Film",
      "description": "Complete historical winners of the Berlinale Golden Bear for Best Film.",
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/awards/en/berlinale.list.json"
        }
      ],
      "sortBy": [
        [
          "awardYear",
          "desc"
        ]
      ],
      "layout": "carousel",
      "bindings": [
        "winner",
        "Title with Year"
      ],
      "filters": [
        {
          "id": "berlinale-golden-bear-award",
          "targetType": "movie",
          "field": "award",
          "fieldType": "text",
          "operator": "equals",
          "value": "Golden Bear for Best Film",
          "isNegated": false
        }
      ],
      "filterMatchMode": "all"
    },
