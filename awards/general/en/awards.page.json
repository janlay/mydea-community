  "icon": "trophy",
  "title": "2026 Awards Season",
  "collections": [
    {
      "title": "Academy Awards",
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/awards/en/oscars.list.json"
        }
      ],
      "sortBy": [
        [
          "awardOrder",
          "asc"
        ]
      ],
      "bindings": [
        "winner",
        "award"
      ],
      "filters": [
        {
          "id": "oscars-year-movie",
          "targetType": "movie",
          "field": "awardYear",
          "fieldType": "number",
          "operator": "equals",
          "value": "2026",
          "isNegated": false
        },
        {
          "id": "oscars-year-show",
          "targetType": "show",
          "field": "awardYear",
          "fieldType": "number",
          "operator": "equals",
          "value": "2026",
          "isNegated": false
        }
      ],
      "filterMatchMode": "any",
      "layout": "carousel"
    },
