    {
      "title": "アカデミー賞",
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/awards/ja/oscars.list.json"
        }
      ],
      "sortBy": [
        [
          "awardOrder",
          "asc"
        ]
      ],
      "bindings": [
        "winner",
        "award"
      ],
      "filters": [
        {
          "id": "oscars-year-movie",
          "targetType": "movie",
          "field": "awardYear",
