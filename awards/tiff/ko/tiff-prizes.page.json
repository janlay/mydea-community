      "sortBy": [
        [
          "awardYear",
          "desc"
        ]
      ],
      "limit": 10,
      "layout": "carousel",
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/awards/ko/tiff.list.json"
        }
      ],
      "bindings": [
        "winner",
        "Title with Year"
      ],
      "filters": [
