{
  "schemaVersion": 1,
  "kind": "page",
  "author": "Mydea",
  "title": "Hong Kong Film Awards",
  "description": "Winners of every Hong Kong Film Awards category. 2021 was postponed and merged into 2022.",
  "tags": [
    "award",
    "prize"
  ],
  "icon": "ticket",
  "collections": [
    {
      "title": "Hong Kong Film Awards — Best Film",
      "description": "Complete historical winners of the Hong Kong Film Award for Film.",
      "sortBy": [
        [
          "awardYear",
          "desc"
        ]
      ],
      "layout": "carousel",
      "limit": 10,
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/awards/en/hkfa.list.json"
        }
      ],
      "bindings": [
        "winner",
        "Title with Year"
      ],
      "filters": [
        {
          "id": "hkfa-best-film-award",
          "targetType": "movie",
          "field": "award",
          "fieldType": "text",
          "operator": "equals",
          "value": "Best Film",
          "isNegated": false
        }
      ],
      "filterMatchMode": "all"
    },
