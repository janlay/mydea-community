{
  "schemaVersion": 1,
  "kind": "page",
  "author": "Mydea",
  "title": "Ten Years in Hong Kong",
  "description": "Ten years of the Hong Kong Film Awards. 2021 is absent: it was merged into 2022.",
  "tags": [
    "award",
    "decade"
  ],
  "icon": "ticket",
  "collections": [
    {
      "title": "Hong Kong Film Awards — 2026",
      "description": "Winning films and filmmakers of the 2026 Hong Kong Film Awards.",
      "sortBy": [
        [
          "awardYear",
          "desc"
        ]
      ],
      "layout": "carousel",
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/awards/en/hkfa.list.json"
        }
      ],
      "bindings": [
        "winner",
        "award"
      ],
      "filters": [
        {
          "id": "hkfa-2026-year",
          "targetType": "movie",
          "field": "awardYear",
          "fieldType": "number",
          "operator": "equals",
          "value": "2026",
          "isNegated": false
        }
      ],
      "filterMatchMode": "all"
    },
    {
      "title": "Hong Kong Film Awards 2017–2025",
      "sortBy": [
        [
          "awardYear",
          "desc"
        ]
      ],
      "layout": "grid",
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/awards/en/hkfa.list.json"
        }
      ],
      "bindings": [
        "winner",
        "award"
      ],
      "filters": [
        {
          "id": "older-years-from",
          "targetType": "movie",
          "field": "awardYear",
          "fieldType": "number",
          "operator": "greaterThan",
          "value": "2016",
          "isNegated": false
        },
        {
          "id": "older-years-to",
          "targetType": "movie",
          "field": "awardYear",
          "fieldType": "number",
          "operator": "lessThan",
          "value": "2026",
          "isNegated": false
        }
      ],
      "filterMatchMode": "all",
      "grouping": {
        "field": "awardYear",
        "buckets": "2025,2024,,2017",
        "label": "{start}"
      }
    }
  ]
}
