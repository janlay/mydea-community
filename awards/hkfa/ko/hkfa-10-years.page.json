      "sortBy": [
        [
          "awardYear",
          "desc"
        ]
      ],
      "layout": "carousel",
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/awards/ko/hkfa.list.json"
        }
      ],
      "bindings": [
        "winner",
        "award"
      ],
      "filters": [
        {
          "id": "hkfa-2026-year",
          "targetType": "movie",
          "field": "awardYear",
          "fieldType": "number",
          "operator": "equals",
          "value": "2026",
          "isNegated": false
        }
      ],
      "filterMatchMode": "all"
    },
    {
      "title": "홍콩 영화 금상장 2017–2025",
      "sortBy": [
        [
          "awardYear",
          "desc"
        ]
      ],
      "layout": "grid",
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/awards/ko/hkfa.list.json"
        }
      ],
      "bindings": [
        "winner",
        "award"
      ],
      "filters": [
        {
          "id": "older-years-from",
          "targetType": "movie",
          "field": "awardYear",
          "fieldType": "number",
          "operator": "greaterThan",
