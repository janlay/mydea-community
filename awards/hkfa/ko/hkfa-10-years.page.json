          "isNegated": false
        },
        {
          "id": "older-years-to",
          "targetType": "movie",
          "field": "awardYear",
          "fieldType": "number",
          "operator": "lessThan",
          "value": "2026",
          "isNegated": false
        }
      ],
      "filterMatchMode": "all",
      "grouping": {
        "field": "awardYear",
        "buckets": "2025,2024,,2017",
        "label": "{start}"
      }
    }
  ]
