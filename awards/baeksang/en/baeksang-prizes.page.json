      "title": "Baeksang Arts Awards — Film Grand Prize",
      "description": "Baeksang Arts Awards Film Grand Prize winners from 2017 to 2026.",
      "sortBy": [
        [
          "awardYear",
          "desc"
        ]
      ],
      "layout": "carousel",
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/awards/en/baeksang.list.json"
        }
      ],
      "limit": 10,
      "bindings": [
        "winner",
        "Title with Year"
      ],
      "filters": [
        {
          "id": "baeksang-film-grand-award",
          "targetType": "movie",
          "field": "award",
          "fieldType": "text",
          "operator": "equals",
          "value": "Film Grand Prize",
          "isNegated": false
        }
      ],
      "filterMatchMode": "all"
