      "sortBy": [
        [
          "awardYear",
          "desc"
        ]
      ],
      "layout": "carousel",
      "limit": 10,
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/awards/ja/oscars.list.json"
        }
      ],
      "bindings": [
        "winner",
        "Title with Year"
