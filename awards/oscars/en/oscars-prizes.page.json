  "sections": [
    {
      "title": "Oscars — Best Picture",
      "description": "Ten-year winner history for the Academy Award for Best Picture.",
      "sortBy": [
        [
          "awardYear",
          "desc"
        ]
      ],
      "layout": "carousel",
      "limit": 10,
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/awards/en/oscars.list.json"
        }
      ],
      "bindings": [
        "winner",
        "Title with Year"
      ],
      "filters": [
        {
          "id": "oscars-best-picture-award",
          "targetType": "movie",
          "field": "award",
          "fieldType": "text",
          "operator": "equals",
          "value": "Best Picture",
          "isNegated": false
        }
      ],
      "filterMatchMode": "all"
    },
