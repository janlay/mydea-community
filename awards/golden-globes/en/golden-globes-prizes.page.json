      "title": "Golden Globes — Best Motion Picture – Drama",
      "description": "Winners of the Golden Globe Best Motion Picture – Drama category from 2017 through 2026.",
      "sortBy": [
        [
          "awardYear",
          "desc"
        ]
      ],
      "layout": "carousel",
      "limit": 10,
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/awards/en/golden-globes.list.json"
        }
      ],
      "bindings": [
        "winner",
        "Title with Year"
      ],
      "filters": [
        {
          "id": "golden-globes-drama-award",
          "targetType": "movie",
          "field": "award",
          "fieldType": "text",
          "operator": "equals",
          "value": "Best Motion Picture – Drama",
          "isNegated": false
        }
      ],
      "filterMatchMode": "all"
    },
