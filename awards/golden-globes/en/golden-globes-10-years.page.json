          "desc"
        ]
      ],
      "layout": "carousel",
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/awards/en/golden-globes.list.json"
        }
      ],
      "bindings": [
        "winner",
        "award"
      ],
      "filters": [
