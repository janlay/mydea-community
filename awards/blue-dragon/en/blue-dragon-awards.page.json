    {
      "title": "Blue Dragon Film Awards — Best Film",
      "description": "Blue Dragon Film Awards Best Film winners from 2016 through 2025.",
      "sortBy": [
        [
          "awardYear",
          "desc"
        ]
      ],
      "layout": "carousel",
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/awards/en/blue-dragon.list.json"
        }
      ],
      "limit": 10,
      "bindings": [
        "winner",
        "Title with Year"
      ],
      "filters": [
        {
          "id": "blue-dragon-best-film-award",
          "targetType": "movie",
          "field": "award",
          "fieldType": "text",
          "operator": "equals",
          "value": "Best Film",
          "isNegated": false
        }
      ],
      "filterMatchMode": "all"
