{
  "schemaVersion": 1,
  "kind": "page",
  "author": "Mydea",
  "title": "Blue Dragon Film Awards — 10 Years",
  "description": "Ten years of the Blue Dragon Film Awards, 2016 to 2025.",
  "tags": [
    "award",
    "decade"
  ],
  "icon": "ticket",
  "sections": [
    {
      "title": "Blue Dragon Film Awards — 2025",
      "description": "Winners in 10 major film categories at the 2025 Blue Dragon Film Awards.",
      "sortBy": [
        [
          "awardYear",
          "desc"
        ]
      ],
      "layout": "carousel",
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/awards/en/blue-dragon.list.json"
        }
      ],
      "bindings": [
        "winner",
        "award"
      ],
      "filters": [
        {
          "id": "blue-dragon-2025-year",
          "targetType": "movie",
          "field": "awardYear",
          "fieldType": "number",
          "operator": "equals",
          "value": "2025",
          "isNegated": false
        }
      ],
      "filterMatchMode": "all"
    },
    {
      "title": "Blue Dragon Film Awards 2016–2024",
      "sortBy": [
        [
          "awardYear",
          "desc"
        ]
      ],
      "layout": "grid",
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/awards/en/blue-dragon.list.json"
        }
      ],
      "bindings": [
        "winner",
        "award"
      ],
      "filters": [
        {
          "id": "older-years-from",
          "targetType": "movie",
          "field": "awardYear",
          "fieldType": "number",
          "operator": "greaterThan",
          "value": "2015",
          "isNegated": false
        },
        {
          "id": "older-years-to",
          "targetType": "movie",
          "field": "awardYear",
          "fieldType": "number",
          "operator": "lessThan",
          "value": "2025",
          "isNegated": false
        }
      ],
      "filterMatchMode": "all",
      "grouping": {
        "field": "awardYear",
        "buckets": "2024,2023,,2016",
        "label": "{start}"
      }
    }
  ]
}
