{
  "schemaVersion": 1,
  "kind": "page",
  "author": "Mydea",
  "icon": "chart.line.uptrend.xyaxis",
  "title": "TMDB 인기",
  "collections": [
    {
      "title": "이번 주 트렌드",
      "service": "tmdb",
      "query": "tmdb_trending",
      "params": [
        {
          "name": "media_type",
          "value": ""
        }
      ],
      "layout": "carousel"
    },
    {
      "title": "현재 상영작",
      "service": "tmdb",
      "query": "tmdb_now_playing",
      "params": [
        {
          "name": "region",
          "value": "{{region}}"
        }
      ],
      "layout": "grid"
    },
    {
      "title": "인기 TV 시리즈",
      "service": "tmdb",
      "query": "tmdb_regional",
      "params": [
        {
          "name": "media_type",
          "value": "tv"
        },
        {
          "name": "region",
          "value": "{{region}}"
        },
        {
          "name": "regional_scope",
          "value": "origin"
        }
      ],
      "layout": "grid"
    },
    {
      "title": "스트리밍 인기작",
      "service": "tmdb",
      "query": "tmdb_regional",
      "params": [
        {
          "name": "media_type",
          "value": ""
        },
        {
          "name": "region",
          "value": "{{region}}"
        },
        {
          "name": "regional_scope",
          "value": "streaming"
        }
      ],
      "layout": "grid"
    }
  ]
}
