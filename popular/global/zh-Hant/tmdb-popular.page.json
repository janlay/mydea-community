{
  "schemaVersion": 1,
  "kind": "page",
  "author": "Mydea",
  "icon": "chart.line.uptrend.xyaxis",
  "title": "TMDB 熱門",
  "collections": [
    {
      "title": "本週熱門影視",
      "service": "tmdb",
      "query": "tmdb_trending",
      "params": [
        {
          "name": "media_type",
          "value": ""
        }
      ],
      "layout": "carousel"
    },
    {
      "title": "正在上映",
      "service": "tmdb",
      "query": "tmdb_now_playing",
      "params": [
        {
          "name": "region",
          "value": "{{region}}"
        }
      ],
      "layout": "grid"
    },
    {
      "title": "熱門電視劇",
      "service": "tmdb",
      "query": "tmdb_regional",
      "params": [
        {
          "name": "media_type",
          "value": "tv"
        },
        {
          "name": "region",
          "value": "{{region}}"
        },
        {
          "name": "regional_scope",
          "value": "origin"
        }
      ],
      "layout": "grid"
    },
    {
      "title": "串流熱門",
      "service": "tmdb",
      "query": "tmdb_regional",
      "params": [
        {
          "name": "media_type",
          "value": ""
        },
        {
          "name": "region",
          "value": "{{region}}"
        },
        {
          "name": "regional_scope",
          "value": "streaming"
        }
      ],
      "layout": "grid"
    }
  ]
}
