{
  "schemaVersion": 1,
  "kind": "page",
  "author": "Mydea",
  "icon": "chart.line.uptrend.xyaxis",
  "title": "TMDB 热门",
  "collections": [
    {
      "title": "本周热门影视",
      "service": "tmdb",
      "query": "tmdb_trending",
      "params": [
        {
          "name": "media_type",
          "value": ""
        }
      ],
      "layout": "carousel"
    },
    {
      "title": "正在上映",
      "service": "tmdb",
      "query": "tmdb_now_playing",
      "params": [
        {
          "name": "region",
          "value": "{{region}}"
        }
      ],
      "layout": "grid"
    },
    {
      "title": "热门电视剧",
      "service": "tmdb",
      "query": "tmdb_regional",
      "params": [
        {
          "name": "media_type",
          "value": "tv"
        },
        {
          "name": "region",
          "value": "{{region}}"
        },
        {
          "name": "regional_scope",
          "value": "origin"
        }
      ],
      "layout": "grid"
    },
    {
      "title": "流媒体热门",
      "service": "tmdb",
      "query": "tmdb_regional",
      "params": [
        {
          "name": "media_type",
          "value": ""
        },
        {
          "name": "region",
          "value": "{{region}}"
        },
        {
          "name": "regional_scope",
          "value": "streaming"
        }
      ],
      "layout": "grid"
    }
  ]
}
