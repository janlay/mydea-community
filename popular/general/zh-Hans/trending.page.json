  "icon": "flame",
  "title": "热门",
  "collections": [
    {
      "title": "实时热门",
      "service": "douban",
      "query": "collection",
      "params": [
        {
          "name": "collection",
          "value": "movie_real_time_hotest"
        }
      ],
      "layout": "carousel",
      "cacheTtlInDays": 1
    },
    {
      "title": "影院上映",
      "service": "douban",
      "query": "theaters",
      "params": [
        {
          "name": "theaters_region",
