{
  "schemaVersion": 1,
  "kind": "page",
  "author": "Mydea",
  "icon": "flame",
  "title": "熱門",
  "originRegionFilter": {
    "hiddenRegion": "IN"
  },
  "collections": [
    {
      "title": "串流熱榜",
      "service": "mdblistsimulated",
      "query": "mdblist_simulated_official",
      "params": [
        {
          "name": "official_slug",
          "value": "streaming-charts"
        },
        {
          "name": "official_mediatype",
          "value": "movies"
        },
        {
          "name": "page_size",
          "value": "20"
        }
      ],
      "excludedRegions": [
        "CN"
      ],
      "layout": "carousel"
    },
    {
      "title": "正在上映",
      "service": "imdb",
      "query": "imdb_showtimes",
      "params": [
        {
          "name": "region",
          "value": "{{region}}"
        },
        {
          "name": "showtimes_sort",
          "value": "rating"
        }
      ],
      "excludedRegions": [
        "CN"
      ],
      "bindings": [
        "Title with Year",
        "regionalReleaseDate"
      ],
      "layout": "film"
    },
    {
      "title": "即將上映",
      "service": "imdb",
      "query": "imdb_coming_soon",
      "params": [
        {
          "name": "region",
          "value": "{{region}}"
        }
      ],
      "bindings": [
        "Title with Year",
        "regionalReleaseDate"
      ],
      "layout": "grid"
    },
    {
      "title": "Netflix 熱門電影",
      "service": "nuvio",
      "query": "netflix_top10",
      "params": [
        {
          "name": "media_type",
          "value": "movie"
        },
        {
          "name": "region",
          "value": "{{region}}"
        }
      ],
      "excludedRegions": [
        "CN"
      ],
      "layout": "itunes"
    },
    {
      "title": "Netflix 熱門劇集",
      "service": "nuvio",
      "query": "netflix_top10",
      "params": [
        {
          "name": "media_type",
          "value": "series"
        },
        {
          "name": "region",
          "value": "{{region}}"
        }
      ],
      "excludedRegions": [
        "CN"
      ],
      "layout": "itunes"
    },
    {
      "title": "本週熱門電影",
      "service": "letterboxd",
      "query": "letterboxd_custom_list",
      "params": [
        {
          "name": "list_shortcut",
          "value": "this/week"
        },
        {
          "name": "list_url",
          "value": "this/week"
        }
      ],
      "layout": "grid"
    },
    {
      "title": "熱門電影排行",
      "service": "imdb",
      "query": "imdb_custom_list",
      "params": [
        {
          "name": "chart_shortcut",
          "value": "moviemeter"
        },
        {
          "name": "list_url",
          "value": "moviemeter"
        }
      ],
      "layout": "grid"
    },
    {
      "title": "IMDb Top 250",
      "service": "imdb",
      "query": "imdb_custom_list",
      "params": [
        {
          "name": "chart_shortcut",
          "value": "top"
        },
        {
          "name": "list_url",
          "value": "top"
        },
        {
          "name": "page_size",
          "value": "100"
        }
      ],
      "layout": "hive",
      "cacheTtlInDays": 30
    }
  ],
  "showsCollectionServiceIcons": true
}
