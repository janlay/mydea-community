{
  "schemaVersion": 1,
  "kind": "page",
  "author": "Mydea",
  "icon": "filemenu.and.selection",
  "title": "Selected Collections",
  "originRegionFilter": {
    "hiddenRegion": "IN"
  },
  "collections": [
    {
      "title": "",
      "service": "rottentomatoes",
      "query": "rotten_tomatoes_browse",
      "params": [
        {
          "name": "category",
          "value": "movies_in_theaters"
        },
        {
          "name": "critics",
          "value": "certified_fresh"
        },
        {
          "name": "audience",
          "value": "verified_hot"
        }
      ],
      "layout": "carousel",
      "cacheTtlInDays": 1
    },
    {
      "title": "Now Playing",
      "service": "tmdb",
      "query": "tmdb_now_playing",
      "params": [
        {
          "name": "region",
          "value": "{{region}}"
        }
      ],
      "layout": "grid",
      "cacheTtlInDays": 1
    },
    {
      "title": "Lex Fridman",
      "service": "youtube",
      "query": "youtube_channel",
      "params": [
        {
          "name": "channel",
          "value": "https://www.youtube.com/@lexfridman"
        }
      ],
      "layout": "hero"
    },
    {
      "title": "Popular Movies",
      "service": "mdblistsimulated",
      "query": "mdblist_simulated_official",
      "params": [
        {
          "name": "official_shortcut",
          "value": "popular"
        },
        {
          "name": "official_slug",
          "value": "popular"
        }
      ],
      "layout": "grid"
    },
    {
      "title": "Academy Award for Best Director",
      "service": "tvdb",
      "query": "tvdb_award_categories",
      "params": [
        {
          "name": "award_category",
          "value": "9"
        }
      ],
      "layout": "itunes",
      "cacheTtlInDays": 360
    },
    {
      "title": "NYT — Top 10 of 100 Best Movies",
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/press/en/nyt-best-movies-21st-century.list.json"
        }
      ],
      "limit": 10,
      "sortBy": [
        [
          "rank",
          "asc"
        ]
      ],
      "bindings": [
        "title with year",
        "ranking"
      ],
      "filters": [
        {
          "id": "nyt-movies-top10",
          "targetType": "movie",
          "field": "rank",
          "fieldType": "number",
          "operator": "lessThan",
          "value": "11",
          "isNegated": false
        }
      ],
      "layout": "itunes",
      "cacheTtlInDays": 360
    },
    {
      "title": "NYT — Top 10 of 100 Best TV Shows",
      "service": "mydea",
      "query": "list",
      "params": [
        {
          "name": "url",
          "value": "pool/press/en/nyt-best-tv-shows-21st-century.list.json"
        }
      ],
      "limit": 10,
      "sortBy": [
        [
          "rank",
          "asc"
        ]
      ],
      "bindings": [
        "title with year",
        "ranking"
      ],
      "filters": [
        {
          "id": "nyt-tv-shows-top10",
          "targetType": "show",
          "field": "rank",
          "fieldType": "number",
          "operator": "lessThan",
          "value": "11",
          "isNegated": false
        }
      ],
      "layout": "itunes"
    }
  ],
  "showsCollectionServiceIcons": true
}
